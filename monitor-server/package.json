{
  "name": "dexholdem-monitor",
  "version": "1.0.0",
  "description": "Real-time monitor for DexHoldem agent experiments",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc && npm run build:client && npm run copy:static",
    "build:client": "esbuild src/client/app.ts --bundle --outfile=dist/client/app.js --minify",
    "copy:static": "cp src/client/index.html src/client/styles.css dist/client/",
    "start": "node dist/server/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "express": "^4.18.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.2"
  }
}
